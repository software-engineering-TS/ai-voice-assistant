# Application
APP_NAME=AI Voice Assistant
APP_VERSION=1.1.0
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/assistant.db

# Ollama (local LLM)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_PREDICT=400
MAX_RETRIES=3
REQUEST_TIMEOUT=180

# Speech
TTS_VOICE=en-IN-NeerjaNeural
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_UPLOAD_SIZE_MB=20

# Files and RAG
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
MAX_UPLOAD_SIZE_MB=20
CHROMA_DB_PATH=vector_db
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RAG_SEARCH_TOP_K=15
RAG_TOP_K=5
RAG_MIN_RELEVANCE=1

# CORS and remote access
# Comma-separated browser origins. CORS is not an authentication mechanism.
ALLOWED_ORIGINS=http://localhost:8501
# Leave blank for local-only development. Set a long random secret before
# binding HOST to a non-loopback interface. Send it as Authorization: Bearer <token>.
API_ACCESS_TOKEN=
